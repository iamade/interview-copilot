# Interview Copilot - Environment Variables
# Copy this to .env and fill in your API keys

# Anthropic (Claude) - Default provider
ANTHROPIC_API_KEY=your-anthropic-api-key

# MiniMax (direct, OpenAI-compatible)
MINIMAX_API_KEY=your-minimax-api-key
# Optional override (defaults to https://api.minimax.io/v1/chat/completions)
# MINIMAX_ENDPOINT=https://api.minimax.io/v1/chat/completions

# OpenAI (GPT-5.4 Codex + Whisper transcription)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# GLM (Zhipu AI)
GLM_API_KEY=your-glm-api-key

# Ollama Cloud (remote models)
OLLAMA_ENDPOINT=https://api.ollama.com
OLLAMA_API_KEY=your-ollama-cloud-api-key

# OpenClaw / OpenRouter (OpenClaw uses OpenRouter as backend)
OPENCLAW_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENCLAW_API_KEY=your-openrouter-api-key

# OpenRouter (direct access to any model)
OPENROUTER_API_KEY=your-openrouter-api-key
