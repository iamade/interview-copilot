# Interview Copilot - Environment Variables
# Copy this to .env and fill in your API keys.
# Real .env is gitignored. Tobi's ~/.openclaw/.env is also auto-loaded as a
# secondary source for any keys not set here (per Ade 21:02 MDT Aug 11).
# Placeholders starting with "your-" are skipped by the runtime loader.

# ============================================================================
# LLM Providers
# ============================================================================

# Anthropic (Claude) — primary per Ade's directive
ANTHROPIC_API_KEY=your-anthropic-api-key

# MiniMax (direct, OpenAI-compatible) — frontier 1M ctx
MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_ENDPOINT=https://api.minimax.io/v1/chat/completions

# OpenAI (GPT + Whisper transcription)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini — also auto-loads from Tobi's GOOGLE_API_KEY
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Ollama Cloud (OLLAMA_API_KEY) — auto-loads from Tobi's OLLAMA_API_KEY
OLLAMA_API_KEY=your-ollama-cloud-api-key
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY_2=your-second-ollama-key-for-rotation  # auto-loads from Tobi's OLLAMA_OPENCLAW_AGENTS_API_KEY_2

# GLM (Zhipu AI direct)
GLM_API_KEY=your-glm-api-key

# Z.AI (GLM coding endpoint) — auto-loads from Tobi's ZAI_API_KEY
ZAI_API_KEY=your-zai-api-key
# ZAI_ENDPOINT=https://api.z.ai/api/coding/paas/v4

# Kimi Code (direct) — auto-loads from Tobi's KIMI_API_KEY_MAC_OPENCLAW
KIMI_API_KEY=your-kimi-api-key
# KIMI_ENDPOINT=https://api.kimi.com/coding/v1

# PiAPI (PAYG, has cost) — auto-loads from Tobi's PIAPI_KEY_FOR_TOBI
PIAPI_API_KEY=your-piapi-api-key
# PIAPI_ENDPOINT=https://api.piapi.ai/v1

# Qwen (Aliyun DashScope / Token Plan) — auto-loads from Tobi's DIRECT_QWEN_MAC_VPS_OPENCLAW_KEY
# CRITICAL: use Token Plan URL for sk-sp-... PAYG keys. Regular DashScope returns 401.
QWEN_API_KEY=your-qwen-api-key
QWEN_OPENAI_COMPATIBLE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# DashScope (regular Aliyun, OpenAI-compatible) — BROKEN for sk-sp-... keys
DASHSCOPE_API_KEY=your-dashscope-api-key
# DASHSCOPE_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenClaw / OpenRouter (OpenClaw uses OpenRouter as backend)
OPENCLAW_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENCLAW_API_KEY=your-openrouter-api-key

# OpenRouter (direct access to any model)
OPENROUTER_API_KEY=your-openrouter-api-key

# ============================================================================
# Tobi's .env as secondary source (auto-loaded at runtime)
# ============================================================================
# If you don't set the keys above, the Copilot will also read from:
#   /Users/adesegunkoiki/.openclaw/.env
# and pick up the following Tobi-specific keys (with fallbacks):
#   ANTHROPIC_API_KEY_ORG_FALLBACK → anthropic
#   GOOGLE_API_KEY → gemini
#   ZAI_API_KEY / Z_AI_API_KEY → zai
#   KIMI_API_KEY_MAC_OPENCLAW → kimi-code
#   PIAPI_KEY_FOR_TOBI → piapi
#   OLLAMA_OPENCLAW_AGENTS_API_KEY_2 → ollama2
#   DIRECT_QWEN_MAC_VPS_OPENCLAW_KEY → qwen (Token Plan URL)
#   QWEN_OpenAI_Compatible_URL → qwen endpoint
# Copilot's own .env takes precedence when both are set.
